# Public site origin, used for canonical and OpenGraph URLs.
NEXT_PUBLIC_SITE_URL=https://kosbahagia.com

# Where the "Punya kos? Gabung jadi mitra" footer link points.
NEXT_PUBLIC_MITRA_URL=https://mitra.kosbahagia.com

# Supabase — local values are printed by `npx supabase start` / `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Owner surface (task 08)
# Set to 1 once a WhatsApp OTP provider is configured in Supabase Auth; otherwise SMS.
NEXT_PUBLIC_WA_OTP=0
# Our team's WhatsApp number for the Paket page.
NEXT_PUBLIC_WA_TIM=6281234567890
# Cron: Monday reminders. Vercel sends this as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Meta WhatsApp Cloud API for reminders; leave empty for a dry run.
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_ID=

# Launch (task 09)
# Plausible/Umami-style cookieless analytics on the renter surface; empty = off.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
# Any JSON-accepting webhook for error reports (server + client); empty = console only.
ERROR_WEBHOOK_URL=
